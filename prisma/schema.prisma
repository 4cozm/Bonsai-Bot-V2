generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RegStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

model DiscordUser {
  id        String   @id // discord snowflake (string)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 캐릭터들
  characters    EveCharacter[]
  // 등록 시도들
  registrations EsiRegistration[]
}

model EveCharacter {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discordUserId String
  discordUser   DiscordUser @relation(fields: [discordUserId], references: [id], onDelete: Cascade)

  characterId   BigInt @unique // EVE character_id (global unique)
  characterName String

  // 자동판정(초기값) + 나중에 수동 변경 가능
  isMain Boolean @default(false)

  // (선택) ESI 토큰 저장 위치: 보안/회전 고려해서 암호화된 문자열로 저장하는게 보통
  accessToken    String?   @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?

  @@index([discordUserId])
  @@index([characterName])
}

model EsiRegistration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discordUserId String
  discordUser   DiscordUser @relation(fields: [discordUserId], references: [id], onDelete: Cascade)

  // state에서 복원되는 nonce (1회성 소비)
  stateNonce String   @unique
  stateExpAt DateTime

  // 디스코드 표시명(요청 시점)
  discordNick String

  // 콜백에서 verify로 얻는 값
  characterId   BigInt?
  characterName String?

  // main/alt “후보 판정”
  mainCandidate Boolean @default(false)

  status RegStatus @default(PENDING)

  // 콜백에서 받은 토큰(esi-complete에서 EveCharacter로 옮긴 후 null 처리)
  accessToken    String?   @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?

  // 디스코드 응답 편의(예: editReply 대상)
  guildId   String?
  channelId String?
  messageId String?

  @@index([discordUserId, status])
  @@index([createdAt])
}

// 테넌트 DB 소프트 격리: 워커 부팅 시 연결 DB의 tenantKey와 일치 검증(fail-fast)
model TenantMeta {
  id        String   @id @default(cuid())
  tenantKey String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 재고 추적 대상 구조물. 구조물을 소유한 콥과 콥행어(오피스)를 실제로 들고
// 있는 콥이 다를 수 있어(2026-08 확인) corporationId를 따로 저장한다 —
// 동기화 크론이 이 값으로 EVE_ANCHOR_CHARIDS에서 맞는 앵커 캐릭터를 찾는다.
model TrackedStructure {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  structureId   BigInt  @unique // 구조물 item_id (예: SAVE CAT = 1051025995560)
  corporationId Int // 콥행어(오피스)를 실제로 들고 있는 콥
  displayName   String // 표시용 이름 (예: "SAVE CAT")
  active        Boolean @default(true) // false면 동기화 스킵(파괴/철거 등)

  targets       StockTarget[]
  logs          StockLog[]
  divisionRules StockDivisionRule[]
}

// 품목별 목표 재고 수량. 프론트에서 명시적으로 목표를 설정한 품목만 생긴다.
model StockTarget {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  structure   TrackedStructure @relation(fields: [structureId], references: [structureId])
  structureId BigInt
  typeId      Int // EVE type_id
  targetQty   Int

  @@unique([structureId, typeId])
}

// 재고 수량 스냅샷 로그. 목표 설정 여부와 무관하게 콥행어에서 발견된 품목
// 전부(구조물 전체 재귀 합산 1건) 기록한다 — "현재 재고"는 최신 행 조회로
// 구한다(별도 캐시 컬럼 없음). ESI 콥 자산 엔드포인트가 최대 1시간 캐시라
// 동기화 크론도 그 이상 자주 돌 필요는 없다.
model StockLog {
  id        String   @id @default(cuid())
  sampledAt DateTime @default(now())

  structure     TrackedStructure @relation(fields: [structureId], references: [structureId])
  structureId   BigInt
  typeId        Int
  quantity      Int
  division      Int? // 1-7 (CorpSAG division). 이 컬럼 추가 이전 행은 null.
  containerName String? // 행어 안 이름 붙은 하위 컨테이너 안에 있으면 그 이름, 아니면 null.

  @@index([structureId, typeId, sampledAt])
  @@index([structureId, division, sampledAt])
}

// 행어(division)·하위 컨테이너별 추적 여부 + 표시 이름. containerName이 null이면
// division 전체에 적용되는 규칙(예: 행어1 전체 제외), 값이 있으면 그 컨테이너에만 적용.
// 규칙 평가는 packages/worker/src/schedulers/stockDivisionRules.js의 isTracked() 참고 —
// containerName 없는 아이템은 규칙 없으면 기본 추적, containerName 있는 아이템은
// tracked:true 규칙이 명시적으로 있어야만 추적(기본 미추적).
model StockDivisionRule {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  structure     TrackedStructure @relation(fields: [structureId], references: [structureId])
  structureId   BigInt
  division      Int // 1-7
  containerName String? // null = division 전체 규칙
  tracked       Boolean @default(true)
  displayName   String // 프론트 표시용 (예: "PVP", "드론")

  @@unique([structureId, division, containerName])
}
